+def test_d_a_annotated_and_unverdicted_failures_never_qualify():
+    """D-A: B5 run 2 recorded its results without a verdict; the fail verdict comes from the annotation ledger.
+    Either way the strategy is refused and the proposal stays 100% VWRP."""
+    h = [{"ticker": "X", "weight": 0.02, "sic": 2834}]
+    bare = [{"event": "register", "id": "B5-V3", "kind": "trial"}, {"event": "result", "id": "B5-V3", "sr_monthly": 0.16}]
+    for events, why in ((bare, "results are none"),
+                        (bare + [{"event": "verdict_annotation", "id": "B5-V3", "verdict": "fail"}], "['fail']")):
+        r = pm.propose(eligible_cfg=strat(h, trials=("B5-V3",)), trial_events=events, look_cfg=LOOK, today=TODAY)
+        assert r["verdict"] == "default" and why in r["refused_strategies"][0]["reason"]
+    # an annotation cannot turn a recorded fail into a pass, nor qualify a trial that has no result
+    for events in (REG + [{"event": "verdict_annotation", "id": "T-FAIL", "verdict": "pass"}],
+                   [{"event": "register", "id": "N", "kind": "trial"},
+                    {"event": "verdict_annotation", "id": "N", "verdict": "pass"}]):
+        tid = "T-FAIL" if events[0] is REG[0] else "N"
+        r = pm.propose(eligible_cfg=strat(h, trials=(tid,)), trial_events=events, look_cfg=LOOK, today=TODAY)
+        assert r["verdict"] == "default"
+
+
+def test_d_a_real_registry_b5_v3_trials_are_refused(tmp_path):
+    """The committed registry (plus the annotation ledger when present): listing either B5 V3 trial is refused."""
+    import json
+    root = Path(pm.__file__).resolve().parents[2]
+    events = [json.loads(x) for p in ("research/edge/trials.jsonl", "research/edge/verdict_annotations.jsonl")
+              if (root / p).exists() for x in (root / p).read_text().splitlines() if x.strip()]
+    for tid in ("B5-H1-FCFPS-ACCEL-V3", "B5-S2A-GP-12M-V3", "S2-S2a", "S2-S1a"):
+        r = pm.propose(eligible_cfg=strat([{"ticker": "X", "weight": 0.02, "sic": 2834}], trials=(tid,)),
+                       trial_events=events, look_cfg=LOOK, today=TODAY)
+        assert r["verdict"] == "default" and r["refused_strategies"][0]["id"] == "S", tid

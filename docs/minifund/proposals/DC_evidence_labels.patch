         t = e.get("tier", "E0")
-        state = "may drive decisions" if t in DECISION_TIERS else "**unvalidated: not a recommendation**"
+        state = ("may drive decisions" if t in DECISION_TIERS
+                 else "**unvalidated exploratory research: not investable evidence, not a recommendation**")

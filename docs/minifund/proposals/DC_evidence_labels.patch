diff --git a/equity/equity/evidence.py b/equity/equity/evidence.py
index e529c36..11e2935 100644
--- a/equity/equity/evidence.py
+++ b/equity/equity/evidence.py
@@ -32,7 +32,8 @@ def banner(*method_versions: str, cfg: dict | None = None) -> str:
     for m in method_versions:
